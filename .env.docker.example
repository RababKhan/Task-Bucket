# Copy to .env.docker and fill in. Consumed by docker-compose.yml.
# DATABASE_URL, SMTP_HOST/PORT/SECURE are set by compose — don't add them here.

# ---- Postgres (compose builds DATABASE_URL from these) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=task_bucket

# ---- Ports on the host ----
APP_PORT=3000
DB_PORT=5432
MAILPIT_UI_PORT=8025

# ---- Auth (required) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app. Must match your OAuth callback URLs.
AUTH_URL=http://localhost:3000

# ---- OAuth providers (optional; omit to disable that button) ----
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Email ----
# Left unset, compose points the app at the bundled Mailpit (nothing leaves the
# machine). For real delivery, set a verified Resend key instead — lib/email.ts
# prefers RESEND_API_KEY over SMTP.
# RESEND_API_KEY=
EMAIL_FROM=Task Bucket <onboarding@resend.dev>

# ---- Platform console ----
# Comma-separated emails granted the super-admin "Platform" section.
SUPERADMIN_EMAILS=

# ---- Billing display (optional) ----
BILLING_CONTACT_EMAIL=
BANK_NAME=
BANK_BENEFICIARY=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_ROUTING=
BANK_BRANCH_CODE=
BANK_SWIFT=
BANK_IBAN=
BANK_REFERENCE=
