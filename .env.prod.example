# Copy to .env.prod ON THE SERVER and fill in. Never commit the filled-in file.
#   cp .env.prod.example .env.prod && nano .env.prod && chmod 600 .env.prod
#
# DATABASE_URL is assembled by docker-compose.prod.yml — do not set it here.

# ---- Images (written by the deploy workflow; edit only for a manual rollback) ----
APP_IMAGE=ghcr.io/OWNER/task-bucket:latest
MIGRATOR_IMAGE=ghcr.io/OWNER/task-bucket-migrator:latest

# ---- Public address ----
APP_DOMAIN=example.com
LETSENCRYPT_EMAIL=you@example.com

# ---- Postgres ----
POSTGRES_USER=postgres
# 32+ random characters. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=task_bucket

# ---- Auth (required) ----
# Generate with: openssl rand -base64 32
# Changing this signs everyone out.
AUTH_SECRET=
# Must be the https:// URL users actually visit, and must match every OAuth
# callback URL you register.
AUTH_URL=https://example.com
AUTH_TRUST_HOST=true

# ---- OAuth providers (optional; omit to hide that sign-in button) ----
# Callback URLs to register:
#   GitHub: https://example.com/api/auth/callback/github
#   Google: https://example.com/api/auth/callback/google
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Email (required — invites and password resets go through this) ----
# Resend is used when RESEND_API_KEY is set; otherwise SMTP_* is used.
# The sending domain must be verified in Resend, or delivery is limited to
# your own address.
RESEND_API_KEY=
EMAIL_FROM=Task Bucket <no-reply@example.com>

# ---- SMTP fallback (only if you are not using Resend) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---- Platform console ----
# Comma-separated emails granted the super-admin "Platform" section.
SUPERADMIN_EMAILS=

# ---- Billing display (optional) ----
BILLING_CONTACT_EMAIL=
BANK_NAME=
BANK_BENEFICIARY=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_ROUTING=
BANK_BRANCH_CODE=
BANK_SWIFT=
BANK_IBAN=
BANK_REFERENCE=
